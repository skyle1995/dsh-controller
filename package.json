{
  "name": "dsh-controller",
  "version": "0.1.0",
  "description": "DeepSeek Harness 桌面控制器:脱离终端管理 dsh 进程与会话",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^8.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "build": {
    "appId": "com.skyle1995.dsh-controller",
    "productName": "DSH Controller",
    "files": [
      "out/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null,
      "category": "public.app-category.developer-tools"
    }
  }
}