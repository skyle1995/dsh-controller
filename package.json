{
  "name": "dsh-controller",
  "version": "0.1.0",
  "description": "DSH Controller — DeepSeek Harness 管理(CLI 菜单 + 图形界面)",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "prepare:pack": "node scripts/prepare-pack.mjs",
    "dist": "electron-vite build && electron-builder",
    "cli": "node cli/index.mjs",
    "cli:status": "node cli/index.mjs status"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.skyle1995.dsh-controller",
    "productName": "DSH Controller",
    "files": [
      "out/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null,
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "bin": {
    "dshc": "./cli/index.mjs"
  }
}
